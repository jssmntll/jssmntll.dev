---
const navLinks = [
  { href: '#home', label: '/home', section: 'home' },
  { href: '#projects', label: '/projects', section: 'projects' },
  { href: '#experience', label: '/experience', section: 'experience' },
  { href: '#skills', label: '/skills', section: 'skills' },
  { href: '#contact', label: '/contact', section: 'contact' },
];
---

<header class="bg-primary-container border-b border-surface-variant flex justify-between items-center w-full px-md py-xs max-w-container-max mx-auto top-0 z-50 sticky">
  <div class="font-headline text-headline-md font-bold text-secondary">
    [dev_root]
  </div>
  <nav class="hidden md:flex gap-md font-mono text-mono-label">
    {navLinks.map((link) => (
      <a
        href={link.href}
        data-nav-link={link.section}
        class:list={[
          'nav-link border-b-2 pb-1 transition-all duration-200',
          link.section === 'home'
            ? 'text-secondary border-secondary drop-shadow-[0_0_8px_rgba(34,211,238,0.2)]'
            : 'text-on-primary-container hover:text-tertiary border-transparent',
        ]}
      >
        {link.label}
      </a>
    ))}
  </nav>
  <div class="hidden md:flex items-center">
    <span class="material-symbols-outlined text-on-primary-container hover:text-secondary cursor-pointer transition-colors">
      terminal
    </span>
  </div>
</header>

<script>
  function initScrollSpy() {
    const sections = document.querySelectorAll('section[id]');
    const navLinks = document.querySelectorAll('[data-nav-link]');

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            navLinks.forEach((link) => {
              const linkSection = link.getAttribute('data-nav-link');
              if (linkSection === id) {
                link.classList.add('text-secondary', 'border-secondary', 'drop-shadow-[0_0_8px_rgba(34,211,238,0.2)]');
                link.classList.remove('text-on-primary-container', 'border-transparent');
              } else {
                link.classList.remove('text-secondary', 'border-secondary', 'drop-shadow-[0_0_8px_rgba(34,211,238,0.2)]');
                link.classList.add('text-on-primary-container', 'border-transparent');
              }
            });
          }
        });
      },
      {
        rootMargin: '-20% 0px -70% 0px',
        threshold: 0,
      }
    );

    sections.forEach((section) => observer.observe(section));
  }

  document.addEventListener('astro:page-load', initScrollSpy);
  document.addEventListener('DOMContentLoaded', initScrollSpy);
</script>
