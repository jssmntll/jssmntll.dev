---

---

<section
  class="py-24 border-t border-surface-variant grid grid-cols-1 md:grid-cols-12 gap-gutter"
  id="contact"
>
  <div class="md:col-span-7 flex flex-col gap-md">
    <div
      class="bg-surface-container-high rounded-lg border border-surface-variant overflow-hidden flex flex-col h-full"
    >
      <div
        class="bg-surface-variant px-sm py-xs flex items-center justify-between border-b border-outline-variant"
      >
        <div class="flex gap-2">
          <div class="w-3 h-3 rounded-full bg-error"></div>
          <div class="w-3 h-3 rounded-full bg-secondary"></div>
          <div class="w-3 h-3 rounded-full bg-tertiary"></div>
        </div>
        <div class="font-mono text-mono-label text-on-surface-variant">
          sys_log_dump.sh
        </div>
        <div></div>
      </div>
      <div
        class="p-sm md:p-md bg-surface-container-lowest flex-grow font-mono text-mono-code text-on-surface overflow-y-auto"
      >
        <div class="flex flex-col gap-sm">
          <div class="flex items-start gap-sm">
            <span
              class="text-outline-variant select-none w-8 text-right shrink-0 mt-px"
              >01</span
            >
            <span class="text-secondary">$ whoami</span>
          </div>
          <div class="flex items-start gap-sm">
            <span
              class="text-outline-variant select-none w-8 text-right shrink-0 mt-px"
              >02</span
            >
            <span
              class="text-on-surface-variant pl-sm border-l-2 border-surface-variant"
            >
              System Engineer & Software Developer with 5+ years building
              scalable web applications and high-availability systems. Expert in
              PHP (Laravel) and PostgreSQL. Migrating legacy systems, optimizing
              cloud-native architectures, and expanding into Go for
              high-concurrency microservices.
            </span>
          </div>
          <div class="flex items-start gap-sm">
            <span
              class="text-outline-variant select-none w-8 text-right shrink-0 mt-px"
              >03</span
            >
            <span class="text-secondary">$ cat principles.conf</span>
          </div>
          <div class="flex items-start gap-sm">
            <span
              class="text-outline-variant select-none w-8 text-right shrink-0 mt-px"
              >04</span
            >
            <span class="text-tertiary">architecture:</span>
          </div>
          <div class="flex items-start gap-sm">
            <span
              class="text-outline-variant select-none w-8 text-right shrink-0 mt-px"
              >05</span
            >
            <span class="text-on-surface pl-md"
              >Scalable, resilient, and transparent.</span
            >
          </div>
          <div class="flex items-start gap-sm">
            <span
              class="text-outline-variant select-none w-8 text-right shrink-0 mt-px"
              >06</span
            >
            <span class="text-tertiary">code:</span>
          </div>
          <div class="flex items-start gap-sm">
            <span
              class="text-outline-variant select-none w-8 text-right shrink-0 mt-px"
              >07</span
            >
            <span class="text-on-surface pl-md"
              >Treat syntax as communication. Clarity over cleverness.</span
            >
          </div>
          <div class="flex items-start gap-sm">
            <span
              class="text-outline-variant select-none w-8 text-right shrink-0 mt-px"
              >08</span
            >
            <span class="text-tertiary">execution:</span>
          </div>
          <div class="flex items-start gap-sm">
            <span
              class="text-outline-variant select-none w-8 text-right shrink-0 mt-px"
              >09</span
            >
            <span class="text-on-surface pl-md">Performant by default.</span>
          </div>
          <div class="flex items-start gap-sm mt-md">
            <span
              class="text-outline-variant select-none w-8 text-right shrink-0 mt-px"
              >10</span
            >
            <span class="text-secondary">$ ./contact --help</span>
          </div>
          <div class="flex items-start gap-sm">
            <span
              class="text-outline-variant select-none w-8 text-right shrink-0 mt-px"
              >11</span
            >
            <span class="text-on-surface-variant"
              >Send a message via the form on the right. I reply within 24 hours
              on business days.</span
            >
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="md:col-span-5 flex flex-col gap-md">
    <div
      class="bg-surface-container-high rounded-lg border border-surface-variant overflow-hidden"
    >
      <div
        class="bg-surface-variant px-sm py-xs flex items-center gap-sm border-b border-outline-variant"
      >
        <span class="material-symbols-outlined text-secondary text-sm"
          >description</span
        >
        <div class="font-mono text-mono-label text-on-surface-variant">
          contact_config.yaml
        </div>
      </div>
      <div
        class="p-md bg-surface-container-lowest font-mono text-mono-code text-on-surface"
      >
        <form id="contact-form" class="flex flex-col gap-md" novalidate>
          <div class="flex flex-col group">
            <label class="text-secondary mb-base" for="name">sender_name:</label
            >
            <div class="flex items-center">
              <span class="text-tertiary mr-2">-</span>
              <input
                class="w-full bg-transparent border-b border-surface-variant focus:border-secondary focus:outline-none focus:ring-0 text-on-surface placeholder:text-on-surface-variant transition-colors py-1 px-0 font-mono text-mono-code shadow-none"
                id="name"
                name="name"
                placeholder='"Your Name"'
                type="text"
                required
                autocomplete="name"
              />
            </div>
            <span
              id="name-error"
              class="text-error text-caption hidden mt-base"
              role="alert"></span>
          </div>
          <div class="flex flex-col group">
            <label class="text-secondary mb-base" for="email">reply_to:</label>
            <div class="flex items-center">
              <span class="text-tertiary mr-2">-</span>
              <input
                class="w-full bg-transparent border-b border-surface-variant focus:border-secondary focus:outline-none focus:ring-0 text-on-surface placeholder:text-on-surface-variant transition-colors py-1 px-0 font-mono text-mono-code shadow-none"
                id="email"
                name="email"
                placeholder='"jesusmantilla6@gmail.com"'
                type="email"
                required
                autocomplete="email"
              />
            </div>
            <span
              id="email-error"
              class="text-error text-caption hidden mt-base"
              role="alert"></span>
          </div>
          <div class="flex flex-col group">
            <label class="text-secondary mb-base" for="message">payload:</label>
            <div class="flex items-start">
              <span class="text-tertiary mr-2 mt-1">|</span>
              <textarea
                class="w-full bg-transparent border border-surface-variant rounded focus:border-secondary focus:outline-none focus:ring-1 focus:ring-secondary text-on-surface placeholder:text-on-surface-variant transition-colors p-sm font-mono text-mono-code resize-none"
                id="message"
                name="message"
                placeholder="Enter transmission data..."
                rows="4"
                required></textarea>
            </div>
            <span
              id="message-error"
              class="text-error text-caption hidden mt-base"
              role="alert"></span>
          </div>

          <div
            id="form-status"
            class="hidden font-mono text-mono-label"
            role="status"
          >
          </div>

          <div class="mt-sm flex justify-end">
            <button
              id="contact-submit"
              class="bg-secondary text-primary-container hover:bg-secondary-fixed hover:drop-shadow-[0_0_8px_rgba(34,211,238,0.4)] px-md py-xs rounded font-mono text-mono-label transition-colors duration-200 flex items-center gap-xs disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:drop-shadow-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary"
              type="submit"
            >
              <span id="contact-submit-text">Execute_Send()</span>
              <span class="material-symbols-outlined text-sm">send</span>
            </button>
          </div>
        </form>
      </div>
    </div>
    <div>
      <span
        class="inline-flex items-center gap-xs px-md py-xs bg-surface-container-high border border-outline text-on-surface-variant rounded font-mono text-mono-label cursor-default select-none"
        title="CV will be available soon"
      >
        <span class="material-symbols-outlined">description</span>
        <span>CV (coming soon)</span>
      </span>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const statusEl = document.getElementById("form-status") as HTMLDivElement;
  const submitBtn = document.getElementById(
    "contact-submit",
  ) as HTMLButtonElement;
  const submitText = document.getElementById(
    "contact-submit-text",
  ) as HTMLSpanElement;

  function showError(fieldId: string, message: string) {
    const el = document.getElementById(`${fieldId}-error`);
    if (el) {
      el.textContent = message;
      el.classList.remove("hidden");
    }
  }

  function clearErrors() {
    ["name", "email", "message"].forEach((id) => {
      const el = document.getElementById(`${id}-error`);
      if (el) {
        el.textContent = "";
        el.classList.add("hidden");
      }
    });
  }

  function setStatus(type: "success" | "error" | "loading", message: string) {
    statusEl.classList.remove("hidden");
    statusEl.textContent = message;
    statusEl.className = `font-mono text-mono-label ${type === "success" ? "text-tertiary" : type === "error" ? "text-error" : "text-secondary"}`;
  }

  function validateForm(): boolean {
    clearErrors();
    let valid = true;

    const formData = new FormData(form);
    const name = (formData.get("name") as string).trim();
    const email = (formData.get("email") as string).trim();
    const message = (formData.get("message") as string).trim();

    if (!name) {
      showError("name", "sender_name is required");
      valid = false;
    } else if (name.length < 2) {
      showError("name", "Name must be at least 2 characters");
      valid = false;
    }

    if (!email) {
      showError("email", "reply_to is required");
      valid = false;
    } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      showError("email", "Invalid email format — expected user@domain.com");
      valid = false;
    }

    if (!message) {
      showError("message", "payload is required");
      valid = false;
    } else if (message.length < 10) {
      showError("message", "Message must be at least 10 characters");
      valid = false;
    }

    return valid;
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    if (!validateForm()) return;

    submitBtn.disabled = true;
    submitText.textContent = "Sending...";
    setStatus("loading", "Transmitting...");

    try {
      const formData = new FormData(form);
      const data: Record<string, string> = {};
      formData.forEach((value, key) => {
        data[key] = value.toString();
      });

      const response = await fetch("https://formspree.io/f/CHANGEME", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });

      if (response.ok) {
        setStatus(
          "success",
          "[OK] Message delivered. I will reply within 24 hours on business days.",
        );
        form.reset();
      } else {
        throw new Error(`Server responded with ${response.status}`);
      }
    } catch {
      setStatus(
        "error",
        "[ERR] Transmission failed. Please try again or reach me on LinkedIn.",
      );
    } finally {
      submitBtn.disabled = false;
      submitText.textContent = "Execute_Send()";
    }
  });

  ["name", "email", "message"].forEach((id) => {
    const input = document.getElementById(id);
    if (input) {
      input.addEventListener("input", () => {
        const errEl = document.getElementById(`${id}-error`);
        if (errEl && !errEl.classList.contains("hidden")) {
          clearErrors();
          statusEl.classList.add("hidden");
        }
      });
      input.addEventListener("blur", () => {
        if (
          input instanceof HTMLInputElement ||
          input instanceof HTMLTextAreaElement
        ) {
          const value = input.value.trim();
          const fieldId = input.id;
          if (!value && input.required) {
            showError(
              fieldId,
              `${fieldId === "name" ? "sender_name" : fieldId === "email" ? "reply_to" : "payload"} is required`,
            );
          }
        }
      });
    }
  });
</script>
