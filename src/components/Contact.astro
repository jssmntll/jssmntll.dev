---
---

<section class="py-24 border-t border-surface-variant grid grid-cols-1 md:grid-cols-12 gap-gutter" id="contact">
  <div class="md:col-span-7 flex flex-col gap-md">
    <div class="bg-surface-container-high rounded-lg border border-surface-variant overflow-hidden flex flex-col h-full">
      <div class="bg-surface-variant px-sm py-xs flex items-center justify-between border-b border-outline-variant">
        <div class="flex gap-2">
          <div class="w-3 h-3 rounded-full bg-error"></div>
          <div class="w-3 h-3 rounded-full bg-[#eab308]"></div>
          <div class="w-3 h-3 rounded-full bg-tertiary"></div>
        </div>
        <div class="font-mono text-mono-label text-on-surface-variant">sys_log_dump.sh</div>
        <div></div>
      </div>
      <div class="p-sm md:p-md bg-surface-container-lowest flex-grow font-mono text-mono-code text-on-surface overflow-y-auto">
        <div class="flex flex-col gap-sm">
          <div class="flex gap-sm">
            <span class="text-outline-variant select-none w-8 text-right">01</span>
            <span class="text-secondary">$&gt; initiate_bio_sequence</span>
          </div>
          <div class="flex gap-sm">
            <span class="text-outline-variant select-none w-8 text-right">02</span>
            <span class="text-tertiary">[OK] Core modules loaded...</span>
          </div>
          <div class="flex gap-sm mt-sm">
            <span class="text-outline-variant select-none w-8 text-right">03</span>
            <span class="text-on-surface">
              <span class="text-secondary">const</span> <span class="text-[#fcd34d]">philosophy</span> = {
            </span>
          </div>
          <div class="flex gap-sm">
            <span class="text-outline-variant select-none w-8 text-right">04</span>
            <span class="text-on-surface pl-md">
              "architecture": <span class="text-tertiary">"Scalable, resilient, and transparent"</span>,
            </span>
          </div>
          <div class="flex gap-sm">
            <span class="text-outline-variant select-none w-8 text-right">05</span>
            <span class="text-on-surface pl-md">
              "code": <span class="text-tertiary">"Treat syntax as communication. Clarity over cleverness."</span>,
            </span>
          </div>
          <div class="flex gap-sm">
            <span class="text-outline-variant select-none w-8 text-right">06</span>
            <span class="text-on-surface pl-md">
              "execution": <span class="text-tertiary">"Performant by default."</span>
            </span>
          </div>
          <div class="flex gap-sm">
            <span class="text-outline-variant select-none w-8 text-right">07</span>
            <span class="text-on-surface">};</span>
          </div>
          <div class="flex gap-sm mt-sm">
            <span class="text-outline-variant select-none w-8 text-right">08</span>
            <span class="text-secondary">$&gt; cat journey.log</span>
          </div>
          <div class="flex gap-sm">
            <span class="text-outline-variant select-none w-8 text-right">09</span>
            <span class="text-on-surface-variant text-body-md font-body leading-relaxed pl-sm border-l-2 border-surface-variant">
              Initiated career in systems administration, observing how infrastructure breaks at scale.
              Transitioned to backend engineering to build the solutions I previously maintained.
              Currently focused on distributed systems, optimizing microservice communication, and maintaining
              zero-downtime deployment pipelines.
            </span>
          </div>
          <div class="flex gap-sm mt-md">
            <span class="text-outline-variant select-none w-8 text-right">10</span>
            <span class="text-secondary animate-pulse">_</span>
          </div>
        </div>
      </div>
    </div>
    <div class="mt-auto pt-sm">
      <a
        class="inline-flex items-center gap-xs px-md py-xs bg-surface-container-high border border-outline hover:border-tertiary hover:text-tertiary text-on-surface rounded font-mono text-mono-label transition-all duration-200 terminal-glow group"
        href="#"
      >
        <span class="material-symbols-outlined text-secondary group-hover:text-tertiary transition-colors">terminal</span>
        <span>Download_CV.pdf</span>
      </a>
    </div>
  </div>

  <div class="md:col-span-5">
    <div class="bg-surface-container-high rounded-lg border border-surface-variant overflow-hidden h-full flex flex-col">
      <div class="bg-surface-variant px-sm py-xs flex items-center gap-sm border-b border-outline-variant">
        <span class="material-symbols-outlined text-secondary text-sm">description</span>
        <div class="font-mono text-mono-label text-on-surface-variant">contact_config.yaml</div>
      </div>
      <div class="p-md bg-surface-container-lowest flex-grow font-mono text-mono-code text-on-surface">
        <form class="flex flex-col gap-md">
          <div class="flex flex-col group">
            <label class="text-secondary mb-base" for="name">sender_name:</label>
            <div class="flex items-center">
              <span class="text-tertiary mr-2">-</span>
              <input
                class="w-full bg-transparent border-b border-surface-variant focus:border-secondary focus:outline-none focus:ring-0 text-on-surface placeholder:text-on-surface-variant transition-colors py-1 px-0 font-mono text-mono-code shadow-none"
                id="name"
                placeholder='"Your Name"'
                type="text"
              />
            </div>
          </div>
          <div class="flex flex-col group">
            <label class="text-secondary mb-base" for="email">reply_to:</label>
            <div class="flex items-center">
              <span class="text-tertiary mr-2">-</span>
              <input
                class="w-full bg-transparent border-b border-surface-variant focus:border-secondary focus:outline-none focus:ring-0 text-on-surface placeholder:text-on-surface-variant transition-colors py-1 px-0 font-mono text-mono-code shadow-none"
                id="email"
                placeholder='"email@domain.com"'
                type="email"
              />
            </div>
          </div>
          <div class="flex flex-col group">
            <label class="text-secondary mb-base" for="message">payload:</label>
            <div class="flex items-start">
              <span class="text-tertiary mr-2 mt-1">|</span>
              <textarea
                class="w-full bg-transparent border border-surface-variant rounded focus:border-secondary focus:outline-none focus:ring-1 focus:ring-secondary text-on-surface placeholder:text-on-surface-variant transition-colors p-sm font-mono text-mono-code resize-none"
                id="message"
                placeholder="Enter transmission data..."
                rows="4"
              ></textarea>
            </div>
          </div>
          <div class="mt-sm flex justify-end">
            <button
              class="bg-secondary text-primary-container hover:bg-secondary-fixed hover:drop-shadow-[0_0_8px_rgba(34,211,238,0.4)] px-md py-xs rounded font-mono text-mono-label transition-all duration-200 flex items-center gap-xs"
              type="button"
            >
              <span>Execute_Send()</span>
              <span class="material-symbols-outlined text-sm">send</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>
