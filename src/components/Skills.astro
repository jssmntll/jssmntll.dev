---
import { languages, databases, messaging, infrastructure, devTools } from '../data/skills';
---

<section class="py-24 border-t border-surface-variant" id="skills">
  <header class="mb-xl">
    <h2 class="font-headline text-headline-xl text-secondary mb-xs">
      <span class="braces">[</span> Technical Skills Matrix <span class="braces">]</span>
    </h1>
    <p class="font-body text-body-lg text-on-surface-variant max-w-2xl">
      Core proficiencies across backend languages, databases, infrastructure, and development tooling.
    </p>
  </header>

  <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter">
    <div class="md:col-span-7 space-y-md">
      <div class="terminal-card rounded-lg overflow-hidden flex flex-col h-full">
        <div class="bg-surface-container border-b border-surface-variant px-sm py-2 flex items-center gap-2">
          <div class="w-3 h-3 rounded-full bg-error"></div>
          <div class="w-3 h-3 rounded-full bg-tertiary"></div>
          <div class="w-3 h-3 rounded-full bg-secondary"></div>
          <span class="ml-2 font-mono text-mono-label text-on-surface-variant">langs.sh</span>
        </div>
        <div class="p-md flex-grow font-mono text-mono-code flex flex-col gap-sm">
          {languages.map((lang, i) => (
            <div class="flex items-center justify-between group">
              <div class="flex items-center gap-4 w-1/3">
                <span class="line-num text-xs">{String(i + 1).padStart(2, '0')}</span>
                <span class="text-on-surface font-semibold group-hover:text-secondary transition-colors">{lang.name}</span>
              </div>
              <div class="w-2/3 flex items-center gap-2">
                <span class="text-on-surface-variant text-xs opacity-50">[</span>
                <div class="h-2 w-full bg-surface-container-high rounded-full overflow-hidden">
                  <div class="h-full skill-bar-fill" style={`transform: scaleX(${parseInt(lang.level) / 100})`}></div>
                </div>
                <span class="text-on-surface-variant text-xs opacity-50">]</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="md:col-span-5 space-y-md">
      <div class="terminal-card rounded-lg overflow-hidden flex flex-col h-full">
        <div class="bg-surface-container border-b border-surface-variant px-sm py-2 flex items-center gap-2">
          <div class="w-3 h-3 rounded-full bg-surface-variant"></div>
          <div class="w-3 h-3 rounded-full bg-surface-variant"></div>
          <div class="w-3 h-3 rounded-full bg-surface-variant"></div>
          <span class="ml-2 font-mono text-mono-label text-on-surface-variant">data_layer.cfg</span>
        </div>
        <div class="p-md font-mono text-mono-code text-on-surface-variant">
          <div class="mb-4">
            <span class="text-secondary"># Databases</span>
          </div>
          <div class="grid grid-cols-2 gap-4 mb-6">
            {databases.map((db) => (
              <div class="border border-surface-variant rounded p-3 hover:border-secondary transition-colors cursor-default group">
                <div class="flex items-center gap-2 mb-2">
                  <span class="material-symbols-outlined text-sm group-hover:text-secondary">{db.icon}</span>
                  <span class="font-semibold text-on-surface">{db.name}</span>
                </div>
              </div>
            ))}
          </div>
          <div class="mb-4">
            <span class="text-secondary"># Messaging &amp; Streams</span>
          </div>
          <div class="grid grid-cols-2 gap-4">
            {messaging.map((msg) => (
              <div class="border border-surface-variant rounded p-3 hover:border-secondary transition-colors cursor-default group">
                <div class="flex items-center gap-2 mb-2">
                  <span class="material-symbols-outlined text-sm group-hover:text-secondary">{msg.icon}</span>
                  <span class="font-semibold text-on-surface">{msg.name}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="md:col-span-12">
      <div class="terminal-card rounded-lg overflow-hidden flex flex-col md:flex-row">
        <div class="bg-surface-container border-b md:border-b-0 md:border-r border-surface-variant px-sm py-4 flex md:flex-col items-center gap-2 justify-center w-full md:w-auto">
          <span class="font-mono text-mono-label text-on-surface-variant md:-rotate-90 md:w-20 md:h-20 flex items-center justify-center">infra.tf</span>
        </div>
        <div class="p-md flex-grow grid grid-cols-1 md:grid-cols-3 gap-md font-mono text-mono-code">
          {infrastructure.map((infra) => (
            <div class="border border-surface-variant rounded p-sm relative group overflow-hidden">
              <div class="absolute inset-0 bg-secondary/5 opacity-0 group-hover:opacity-100 transition-opacity"></div>
              <div class="relative z-10">
                <h3 class="text-on-surface font-bold text-base mb-2">{infra.name}</h3>
                <p class="text-on-surface-variant text-sm mb-4">{infra.description}</p>
                {infra.tags ? (
                  <div class="flex flex-wrap gap-2 text-xs">
                    {infra.tags.map((tag) => (
                      <span class="bg-surface-container px-2 py-1 rounded text-secondary border border-surface-variant">{tag}</span>
                    ))}
                  </div>
                ) : (
                  <div class="w-full h-1 bg-surface-container-high rounded mt-auto">
                    <div class="h-full bg-secondary rounded" style={`width: ${infra.level}`}></div>
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="md:col-span-12">
      <h3 class="font-headline text-headline-lg text-on-surface mb-md mt-sm">
        <span class="braces">[</span> DevTools Toolbox <span class="braces">]</span>
      </h2>
      <div class="flex flex-wrap gap-sm font-mono text-mono-code">
        {devTools.map((tool) => (
          <div class="px-4 py-2 border border-surface-variant rounded bg-surface-dim hover:border-tertiary hover:text-tertiary transition-colors cursor-default flex items-center gap-2">
            <span class="material-symbols-outlined text-sm">{tool.icon}</span>
            {tool.name}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
