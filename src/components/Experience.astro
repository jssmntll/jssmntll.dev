---
import { getCollection } from 'astro:content';

const experiences = (await getCollection('experience'));
---

<section class="py-24 border-t border-surface-variant" id="experience">
  <header class="mb-xl text-center md:text-left">
    <h1 class="font-headline text-headline-xl-mobile md:text-headline-xl text-on-surface mb-sm">
      [ Experience_Log ]
    </h1>
    <p class="font-body text-body-lg text-on-surface-variant max-w-2xl">
      Career trajectory and professional milestones across systems and backend engineering.
    </p>
  </header>

  <div class="relative border-l-2 border-surface-variant ml-4 md:ml-0 md:pl-8 space-y-xl">
    {experiences.map((exp) => (
      <div class="relative">
        <div class:list={[
          'absolute -left-[1.6rem] md:-left-[2.3rem] top-1 w-4 h-4 rounded-full border-2',
          exp.data.current
            ? 'bg-tertiary border-tertiary'
            : 'bg-surface-container-high border-surface-variant',
        ]}></div>

        <div class="glass-card rounded-lg p-md border border-surface-variant transition-all duration-300 terminal-glow">
          <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-xs mb-sm">
            <div>
              <h2 class="font-headline text-headline-md text-on-surface">{exp.data.role}</h2>
              <span class="font-mono text-mono-label text-secondary">{exp.data.company}</span>
            </div>
            <div class="flex items-center gap-xs">
              {exp.data.current && (
                <span class="font-mono text-caption text-tertiary bg-tertiary-container px-xs py-base rounded-full">current</span>
              )}
              <span class="font-mono text-mono-label text-on-surface-variant">{exp.data.period}</span>
            </div>
          </div>
          <p class="font-body text-body-md text-on-surface-variant">{exp.body}</p>
        </div>
      </div>
    ))}
  </div>
</section>
