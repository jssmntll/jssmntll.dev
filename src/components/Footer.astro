---
const currentYear = new Date().getFullYear();

const socialLinks = [
  { name: 'GitHub', href: '#' },
  { name: 'LinkedIn', href: '#' },
  { name: 'Documentation', href: '#' },
  { name: 'StackOverflow', href: '#' },
];
---

<footer class="bg-surface-dim border-t border-surface-variant flex flex-col md:flex-row justify-between items-center w-full px-md py-lg max-w-container-max mx-auto mt-auto">
  <div class="font-mono text-mono-label text-on-surface-variant mb-4 md:mb-0">
    &copy; {currentYear} Built with Astro &amp; Tailwind.css
  </div>
  <div class="flex gap-md font-mono text-mono-label text-on-surface-variant">
    {socialLinks.map((link) => (
      <a
        class="hover:text-secondary hover:underline decoration-secondary transition-all"
        href={link.href}
      >
        {link.name}
      </a>
    ))}
  </div>
</footer>
